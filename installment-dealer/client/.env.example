# ==============================================================================
# NANDANAM Agencies - Frontend Production Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Web Client Configuration (Required)
# Public project identifiers for Firebase Authentication, Firestore, and Storage.
# Obtain from: Firebase Console -> Project Settings -> General -> Your apps (Web)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyCzDNCxjYhz2sIKv2BIE5v9zo1oCvo1GGw
VITE_FIREBASE_AUTH_DOMAIN=project-karthi-b0f29.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=project-karthi-b0f29
VITE_FIREBASE_STORAGE_BUCKET=project-karthi-b0f29.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=403319967428
VITE_FIREBASE_APP_ID=1:403319967428:web:fd74013a1e7ae896078391

# ------------------------------------------------------------------------------
# 2. Backend Express API URL (Required if backend is deployed separately)
# If the Express backend is deployed to Render, Railway, Cloud Run, Heroku, etc.,
# provide the full HTTPS URL without a trailing slash.
# Example: https://nandanam-agencies-api.onrender.com
# Leave blank ONLY if frontend and backend share the exact same domain / reverse proxy.
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 3. Razorpay Key ID for Online Payment Checkout (Optional / Recommended)
# Public Key ID for client-side Razorpay UPI / Card checkout (rzp_test_... or rzp_live_...)
# If left blank, the frontend automatically queries the backend /api/payments/config endpoint.
# ------------------------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=

# ------------------------------------------------------------------------------
# 4. Google Drive Picker Integration (OAuth 2.0 Web Client ID) (Optional)
# Used by administrators to pick product images directly from Google Drive.
# Create in Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID (Web Application)
# Make sure your production domain is added to "Authorized JavaScript origins".
# Note: Never expose OAuth client secrets in frontend. Client ID is the public identifier.
# ------------------------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=AIzaSyALYdmwJjWOLjKLCqnowmvyZFvdP_SCr4E
VITE_GOOGLE_APP_ID=403319967428

# ------------------------------------------------------------------------------
# 5. Firebase Cloud Messaging Web Push Certificate (VAPID Key) (Optional)
# Obtain from Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates.
# Required if you generate a custom VAPID key pair for browser push notifications.
# ------------------------------------------------------------------------------
VITE_FIREBASE_VAPID_KEY=
