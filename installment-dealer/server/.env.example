# ==============================================================================
# NANDANAM Agencies - Backend Environment Configuration Template (.env.example)
# ==============================================================================

# Server Port (Render sets the PORT environment variable automatically)
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. CORS Allowed Origins
# Specify your deployed frontend URL (or multiple comma-separated URLs).
# Example: https://your-frontend-app.web.app,https://your-custom-domain.com
# If omitted or left empty, all origins are permitted.
# ------------------------------------------------------------------------------
CLIENT_ORIGIN=https://your-frontend-app.web.app

# ------------------------------------------------------------------------------
# 2. Firebase Admin Credentials
# Method A (Recommended for Render):
# Obtain from Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Method B (Alternative for file-based setups):
# GOOGLE_APPLICATION_CREDENTIALS=./config/serviceAccountKey.json

# ------------------------------------------------------------------------------
# 3. Razorpay Payment Gateway Credentials (Optional / for Live Online Payments)
# Obtain from Razorpay Dashboard -> Settings -> API Keys
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
